:[["Хочу тебе кое-что сказать.",0],["Ничего не хочу говорить.",0],["Что ты хочешь сказать?",0],["Скажи мне что-нибудь.",0]],"a":0,"why":"რაღაც — кое-что."},{"q":"Когда нужно -მე, а не -ღაც?","o":[["только о людях",0],["всегда",0],["в прошедшем времени",0],["в вопросах и условиях, когда неизвестно, есть ли вообще",0]],"a":3,"why":"Как «кто-нибудь» и «кто-то»."}]},{"id":"r06","n":6,"title":"Себя и друг друга","short":"თავი, ერთმანეთი, თვითონ","blocks":[["p","Отдельного слова «себя» нет. Вместо него — თავი «голова» с притяжательным: ჩემი თავი «я сам, себя» (буквально «моя голова»), შენი თავი, თავისი თავი."],["ex",[["თავს კარგად ვგრძნობ","tavs k'argad vgrdznob","Я чувствую себя хорошо."],["საკუთარ თავზე ლაპარაკობს","sak'utar tavze lap'arak'obs","Он говорит о себе."]]],["note","Но თავი остаётся и просто головой: თავი მტკივა — «голова болит». Какое значение — ясно из фразы."],["ex",[["თავი მტკივა","tavi mt'k'iva","У меня болит голова."]]],["h","Друг друга: ერთმანეთი"],["p","ერთმანეთი буквально «один другого» и склоняется как существительное."],["ex",[["ერთმანეთს ვიცნობთ","ertmanets vitsnobt","Мы знаем друг друга."],["ერთმანეთი უყვართ","ertmaneti uq'vart","Они любят друг друга."]]],["h","Сам: თვითონ"],["p","Когда «сам» значит «лично, без помощи», говорят თვითონ или თავად."],["ex",[["მე თვითონ გავაკეთებ","me tviton gavak'eteb","Я сам сделаю."]]]],"quiz":[{"q":"Что буквально значит თავი?","o":[["голова",0],["сам",0],["тело",0],["имя",0]],"a":0,"why":"Отсюда и «себя»."},{"q":"Как сказать «я чувствую себя хорошо»?","o":[["თავი კარგია",1],["თავს კარგად ვგრძნობ",1],["ჩემი კარგად ვგრძნობ",1],["მე კარგად ვგრძნობ თვითონ",1]],"a":1,"why":"თავს — «себя»."},{"q":"Что значит თავი მტკივა?","o":[["Он болеет.",0],["Мне больно за себя.",0],["Я сам болен.",0],["У меня болит голова.",0]],"a":3,"why":"Здесь თავი — просто голова."},{"q":"Как сказать «друг друга»?","o":[["თავი",1],["თვითონ",1],["საკუთარი",1],["ერთმანეთი",1]],"a":3,"why":"Буквально «один другого»."},{"q":"Что значит ერთმანეთს ვი